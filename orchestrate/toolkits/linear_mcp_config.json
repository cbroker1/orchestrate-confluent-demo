{
  "name": "linear-mcp",
  "description": "Linear MCP server for creating and managing work orders",
  "type": "mcp",
  "server": {
    "command": "npx",
    "args": [
      "-y",
      "@mseep/linear-mcp"
    ],
    "env": {
      "LINEAR_API_KEY": "${LINEAR_API_KEY}"
    }
  },
  "tools": [
    "create_issue",
    "update_issue",
    "search_issues",
    "get_issue"
  ]
}
